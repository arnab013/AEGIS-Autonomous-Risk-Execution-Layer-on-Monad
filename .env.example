# Server-only key. Never prefix secrets with VITE_.
TYPESAFE_API_KEY=
# Explicit opt-in to using TypeSafe API credits. Replay is free.
JEV_ENABLE_LIVE=false

# The shared AI gateway fails closed without these server secrets and a persistent ledger.
AI_ENABLED=false
SCOUT_PROJECT_PROVIDER=mistral
MISTRAL_API_KEY=
GEMINI_API_KEY=
AI_SESSION_SECRET=
AI_IMPLEMENTATION_TOKEN=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Read real Kuru MON/USDC mainnet market by default. Signing uses real MON.
# testnet is supported, but its documented market currently has no executable bids.
AEGIS_NETWORK=mainnet

# No private key is needed. Transactions use the user's browser wallet.
